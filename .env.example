# Shared
COMPOSE_PROJECT_NAME=nta-platform
APP_IMAGE_TAG=latest
APP_ENV=development
APP_NAME=nta-platform
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://127.0.0.1:8081"]

# Infra / Compose
HTTP_PORT=80
DEV_GATEWAY_PORT=8081
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8088
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
GITEA_HTTP_PORT=3001
GITEA_SSH_PORT=2222
NGINX_VERSION=1.27-alpine
POSTGRESQL_IMAGE=pgvector/pgvector:pg16
TEMPORAL_VERSION=1.29.4
TEMPORAL_ADMINTOOLS_VERSION=1.29.4
TEMPORAL_UI_VERSION=latest
RUSTFS_VERSION=latest
MINIO_MC_VERSION=latest
GITEA_VERSION=1.22
S3_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# Frontend
API_BASE_URL=http://127.0.0.1:8081/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8081/api/v1
NEXT_PUBLIC_SSE_BASE_URL=http://127.0.0.1:8081/api/v1/streams
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8081/ws

# Backend
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_PATH=/api/v1
SECRET_KEY=replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL
POSTGRES_USER=nta
POSTGRES_PASSWORD=nta
POSTGRES_DB=model_forge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nta:nta@localhost:5432/model_forge

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=nta-platform-dev
TEMPORAL_TASK_QUEUE_EVAL=eval-jobs
TEMPORAL_TASK_QUEUE_BATCH=batch-jobs
TEMPORAL_TASK_QUEUE_DATASET=dataset-import

# Object Storage
# Local development defaults to the RustFS stack started by `make infra.up`.
S3_ENDPOINT_URL=http://127.0.0.1:8081
S3_BROWSER_ENDPOINT_URL=http://127.0.0.1:8081
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=ChangeMe123!
S3_BUCKET_MAIN=nta-default
S3_ROOT_PREFIX=nta-dev
S3_DIRECT_UPLOAD_MODE=presigned
S3_STS_DURATION_SECONDS=1800
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=60
S3_MAX_ATTEMPTS=2
NEXT_PUBLIC_OBJECT_STORE_ROOT_PREFIX=nta-dev
S3_LOCAL_FALLBACK_ENABLED=true

# Gitea (data lake backend)
# Backend → Gitea. For dev (backend on host) use 127.0.0.1:GITEA_HTTP_PORT.
# When backend itself runs inside docker compose, set this to http://gitea:3000.
GITEA_INTERNAL_URL=http://127.0.0.1:3001
# Browser-visible URL for clone/web links.
GITEA_EXTERNAL_URL=http://127.0.0.1:3001
# Initial admin bootstrapped by infra/scripts/bootstrap-gitea.sh.
GITEA_ADMIN_USER=nta-admin
GITEA_ADMIN_PASSWORD=ChangeMe123!
GITEA_ADMIN_EMAIL=admin@local.nta
# Populated by bootstrap-gitea.sh on first run.
GITEA_ADMIN_TOKEN=
GITEA_DEFAULT_BRANCH=main
GITEA_ORG_PREFIX=proj-
# Static dev secrets — rotate via bootstrap-gitea.sh --rotate-secrets if needed.
GITEA_SECRET_KEY=replace-me-secret-key-32bytes-base64
GITEA_INTERNAL_TOKEN=replace-me-internal-token-32bytes-base64
GITEA_LFS_JWT_SECRET=replace-me-lfs-jwt-secret-32bytes-base64

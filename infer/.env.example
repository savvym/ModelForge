# Copy this file to infer/.env on the inference machine.
# Do not commit infer/.env because it contains secrets and machine-specific addresses.

HOST=0.0.0.0
PORT=9000
LOG_LEVEL=INFO

NODE_NAME=h20-node-01
INFER_AGENT_TOKEN=replace-with-a-long-random-token

STATE_PATH=/var/lib/infer-agent/state.db
MODEL_CACHE_DIR=/data/model-cache
RUNTIME_DIR=/data/nta-runtime

# Required when the control plane or other services need to call vLLM from outside this host.
# Example: 111.229.120.156 or an internal IP/DNS name reachable from the control plane.
RUNTIME_PUBLIC_HOST=111.229.120.156

DOCKER_BIN=docker
CONTAINER_NAME=nta-vllm
DEFAULT_VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_CONTAINER_PORT=8000
MAX_RUNTIME_RESTARTS=3

# Recommended even for public Hugging Face models to reduce rate limits.
HF_TOKEN=hf_xxx_optional
# HF_ENDPOINT=https://huggingface.co

RECONCILE_INTERVAL_SECONDS=2
HEALTH_TIMEOUT_SECONDS=900
HEALTH_POLL_INTERVAL_SECONDS=2
